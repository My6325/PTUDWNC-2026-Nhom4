# ===================================================================
# CULINARY BLOG - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Được commit lên GitHub làm mẫu hướng dẫn cho các thành viên.
# Khi làm việc cục bộ: Copy file này thành .env và điền mật khẩu thật.
# ===================================================================

# === 1. Supabase Cloud Configuration ===
SUPABASE_URL=https://ckhzgvwmaldvbxgoimjo.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_DB_PASSWORD=your_database_password_here

# === 2. Chuỗi kết nối PostgreSQL (Dành cho EF Core 10 / Npgsql) ===
SUPABASE_CONNECTION_STRING="Host=db.ckhzgvwmaldvbxgoimjo.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your_database_password_here;SSL Mode=Require;Trust Server Certificate=true;"

# === 3. Thiết lập API Server & Bảo mật JWT ===
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=CulinaryBlogAPI
JWT_AUDIENCE=CulinaryBlogClient
