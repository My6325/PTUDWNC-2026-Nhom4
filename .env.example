# ===================================================================
# CULINARY BLOG - MẪU BIẾN MÔI TRƯỜNG (.env.example)
# Khi làm việc cục bộ: Tạo file .env và điền thông số thật.
# ===================================================================

# === 1. Supabase Cloud Configuration ===
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
SUPABASE_DB_PASSWORD=your_database_password_here
# EF Core có thể nhận chuỗi direct; ứng dụng tự chuyển sang Session Pooler IPv4.
SUPABASE_CONNECTION_STRING=Host=db.your-project-ref.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=your_database_password_here;SSL Mode=Require
SUPABASE_POOLER_REGION=ap-southeast-1
# Đặt Require trên máy có TLS hoạt động; Disable là fallback cho Windows Schannel lỗi.
SUPABASE_POOLER_SSL_MODE=Disable
# Có thể đặt chuỗi pooler đầy đủ ở đây để ghi đè cơ chế chuyển đổi tự động.
# SUPABASE_POOLER_CONNECTION_STRING=Host=aws-0-ap-southeast-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.your-project-ref;Password=your_database_password_here;SSL Mode=Require

# === 2. Thiết lập API Server & Bảo mật JWT ===
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long
JWT_ISSUER=CulinaryBlogAPI
JWT_AUDIENCE=CulinaryBlogClient
