{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "RateLimiting": {
    "AuthSensitive": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Smtp": {
    "Host": "localhost",
    "Port": 587,
    "EnableSsl": true,
    "UserName": "",
    "Password": "",
    "FromEmail": "noreply@culinaryblog.local",
    "FromName": "Culinary Blog"
  },
  "Hangfire": {
    "Enabled": false,
    "ConnectionString": ""
  }
}
